# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "The bybit-sim binary, with markets anchored to a live or recorded reference venue"
description:
  "A separate package so that the bybit-sim library stays free of the venue clients, whose tests depend on it."
maintainer: ["winterchill-trading"]
authors: ["winterchill-trading"]
license: "MIT"
homepage: "https://github.com/winterchill-trading/bybit-sim"
bug-reports: "https://github.com/winterchill-trading/bybit-sim/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.17"}
  "core"
  "core_unix"
  "async"
  "cohttp"
  "yojson"
  "uri"
  "fixed-decimal"
  "exchange-core"
  "exchange-core-engine"
  "bybit-protocol"
  "bybit-sim" {= version}
  "market-data"
  "price-anchor"
  "bybit-client"
  "binance-client"
  "ppx_jane"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/winterchill-trading/bybit-sim.git"
